# Copy this file to .env and fill in the key.  .env is git-ignored. Never commit it, never paste the key in chat.

# --- LLM provider (OpenAI-compatible). Swap these three lines to change provider; no code change. ---
DEEPINFRA_API_KEY=
LLM_BASE_URL=https://api.deepinfra.com/v1/openai

# --- Model routing (role -> model id). Verified on deepinfra.com on 2026-11-11. ---
LLM_REASONING_MODEL=google/gemma-4-31B-it
LLM_FAST_MODEL=google/gemma-4-26B-A4B-it
LLM_VISION_MODEL=google/gemma-4-31B-it

LLM_TIMEOUT_S=90

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://mechanic:mechanic@localhost:5432/mechanic_ai

LLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# --- File storage (S3-compatible). These values match docker-compose.yml; on AWS leave the endpoint empty. ---
S3_BUCKET=mechanic-ai
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-identity
S3_SECRET_ACCESS_KEY=local-credential

# --- Review screen: http://localhost:8000/review  (user name = your own name, password = this) ---
REVIEW_PASSWORD=

# --- Web search (app/web; project doc web-search-design.md). Keys: dashboard.exa.ai and app.tavily.com ---
# off = no web search (default). web = when there is no verified data for a fault code, the assistant answers
# from web pages, each linked and marked for the car. Show it to mechanics only after the provider's written OK.
EXTERNAL_SOURCE=off
EXA_API_KEY=
TAVILY_API_KEY=
# Optional (defaults shown): WEB_SEARCH_TYPE=auto  WEB_TIMEOUT_S=6  WEB_BUDGET_S=8  WEB_SEARCHES_PER_SESSION=6
# WEB_BLOCKED_DOMAINS=lemon-manuals.*,lemon-manuals.la,lemon-manuals.org.ua,lemon-manuals.gy,charm.li,17vin.com
