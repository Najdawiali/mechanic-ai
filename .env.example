# Copy this file to .env and fill in the key.  .env is git-ignored. Never commit it, never paste the key in chat.

# --- LLM provider (OpenAI-compatible). Swap these three lines to change provider; no code change. ---
DEEPINFRA_API_KEY=
LLM_BASE_URL=https://api.deepinfra.com/v1/openai

# --- Model routing (role -> model id). Verified on deepinfra.com on 2026-11-11. ---
LLM_REASONING_MODEL=google/gemma-4-31B-it
LLM_FAST_MODEL=google/gemma-4-26B-A4B-it
LLM_VISION_MODEL=google/gemma-4-31B-it

LLM_TIMEOUT_S=180

# --- Which model does each job (reasoning = 31B, fast = 26B A4B). Measured 2026-11-26 on the venorexai benchmark:
# 31B for every role gave quality 75.2 and 4 critical failures, median 31 s per request. ---
LLM_ROLE_GENERAL=reasoning
LLM_ROLE_ADVISE=reasoning
LLM_ROLE_TRANSLATE=reasoning
LLM_ROLE_TRANSLATE_UR=reasoning

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://mechanic:mechanic@localhost:5432/mechanic_ai

LLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# --- File storage (S3-compatible). These values match docker-compose.yml; on AWS leave the endpoint empty. ---
S3_BUCKET=mechanic-ai
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-identity
S3_SECRET_ACCESS_KEY=local-credential

# --- Review screen: http://localhost:8000/review  (user name = your own name, password = this) ---
# On a server use a long random value: python -c "import secrets; print(secrets.token_urlsafe(24))"
REVIEW_PASSWORD=

# --- The backend calls /ai with "Authorization: Bearer <AI_SERVICE_KEY>". Long random value, same as above. ---
AI_SERVICE_KEY=

# --- Knowledge base: serve records (and the safety texts / standard values) the expert has not approved yet.
# false in production until Nasoh approves them; the 2026-11-26 measurement ran with true. ---
KB_SERVE_DRAFTS=false

# --- Local demo page http://localhost:8000/demo (this computer only). Never true on a server. ---
DEMO_ENABLED=false

# --- Web search (app/web; project doc web-search-design.md). Keys: dashboard.exa.ai and app.tavily.com ---
# off = no web search (default). web = when there is no verified data for a fault code, the assistant answers
# from web pages, each linked and marked for the car. Show it to mechanics only after the provider's written OK.
EXTERNAL_SOURCE=web
EXA_API_KEY=
TAVILY_API_KEY=
# Also search by the mechanic's symptom when he gives no fault code.
WEB_SYMPTOM_SEARCH=true
WEB_MAX_RESULTS=8
WEB_TIMEOUT_S=12
WEB_FALLBACK_TIMEOUT_S=10
WEB_BUDGET_S=20
# Sites to never use as a source, comma-separated. Empty = all sites allowed (the default).
# WEB_BLOCKED_DOMAINS=
# Optional (defaults shown): WEB_SEARCH_TYPE=auto  WEB_SEARCHES_PER_SESSION=6

# NHTSA public records (app/public), imported from the venorexai snapshot: off | nhtsa.
# Used when there is no verified data, and as a short note beside a verified answer. Never shown as verified.
# Needs migration 0007 and the import + embedding steps in README ("Production setup").
PUBLIC_RECORDS=nhtsa
# Optional (defaults shown): PUBLIC_RECORD_TYPES=official_recall,official_investigation,unverified_report
#   PUBLIC_EMBEDDING_MODEL=   (empty = LLM_EMBEDDING_MODEL; Qwen/Qwen3-Embedding-8B only if imported with --keep-vectors)
#   PUBLIC_MIN_SIMILARITY=0.5  PUBLIC_MAX_ITEMS=4  PUBLIC_KNOWN_MAX=3
